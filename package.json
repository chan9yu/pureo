{
	"name": "pureo",
	"version": "1.0.0",
	"description": "어려운 주식 숫자를 쉬운 말로 풀어 읽어주는 종목 카드 앱",
	"private": true,
	"engines": {
		"node": "24.x",
		"pnpm": "11.x"
	},
	"packageManager": "pnpm@11.10.0",
	"license": "MIT",
	"scripts": {
		"dev": "next dev --port 3300",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"lint:fsd": "steiger ./src",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"type:check": "tsc --noEmit",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.101.2",
		"next": "^16.2.10",
		"react": "^19.2.7",
		"react-dom": "^19.2.7"
	},
	"devDependencies": {
		"@feature-sliced/steiger-plugin": "^0.6.0",
		"@tailwindcss/postcss": "^4.3.2",
		"@types/node": "^26.1.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"eslint": "^9.39.4",
		"eslint-config-next": "^16.2.10",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-simple-import-sort": "^13.0.0",
		"lefthook": "^2.1.9",
		"msw": "^2.14.6",
		"prettier": "^3.9.4",
		"steiger": "^0.5.13",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.9"
	}
}
